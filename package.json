{
  "name": "easyweather",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint --fix",
    "types": "tsc --noEmit",
    "checks": "npm run types && npm run lint",
    "apk": "expo run:android --variant=release",
    "bundle:android": "cd android && .\\gradlew.bat bundleRelease && cd ..",
    "release:prebuild": "expo prebuild -p android",
    "release:assemble": "cd android && .\\gradlew.bat assembleRelease && cd ..",
    "release:clear-data": "adb shell pm clear com.uwayss.easyweather",
    "release:install": "adb install -f android\\app\\build\\outputs\\apk\\release\\app-release.apk",
    "release:start-app": "adb shell am start -n com.uwayss.easyweather/com.uwayss.easyweather.MainActivity",
    "release": "npm run release:prebuild && npm run release:assemble && npm run release:clear-data && npm run release:install && npm run release:start-app",
    "prebuild": "expo prebuild -p android",
    "deps": "expo install --fix",
    "commit": "npm run checks && ups diff"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^54.0.0",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.19",
    "i18next": "^25.2.0",
    "nativewind": "^4.1.23",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^15.5.1",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
