{
  "name": "easyweather",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint --fix",
    "types": "tsc --noEmit",
    "checks": "npm run types && npm run lint",
    "apk": "expo run:android --variant=release",
    "bundle:android": "cd android && .\\gradlew.bat bundleRelease && cd ..",
    "release:prebuild": "expo prebuild -p android",
    "release:assemble": "cd android && .\\gradlew.bat assembleRelease && cd ..",
    "release:clear-data": "adb shell pm clear com.uwayss.easyweather",
    "release:install": "adb install -f android\\app\\build\\outputs\\apk\\release\\app-release.apk",
    "release:start-app": "adb shell am start -n com.uwayss.easyweather/com.uwayss.easyweather.MainActivity",
    "release": "npm run release:prebuild && npm run release:assemble && npm run release:clear-data && npm run release:install && npm run release:start-app",
    "prebuild": "expo prebuild -p android",
    "deps": "expo install --fix",
    "commit": "npm run checks && ups diff"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^57.0.0",
    "expo-build-properties": "~57.0.7",
    "expo-constants": "~57.0.7",
    "expo-dev-client": "~57.0.9",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-location": "~57.0.6",
    "expo-router": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-updates": "~57.0.10",
    "i18next": "^26.3.6",
    "nativewind": "^4.1.23",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.11",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/react": "~19.2.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "overrides": {
    "uuid": "11.1.1"
  }
}
