{
  "name": "easyweather",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint --fix",
    "types": "tsc --noEmit",
    "checks": "npm run types && npm run lint",
    "apk": "expo run:android --variant=release",
    "bundle:android": "cd android && .\\gradlew.bat bundleRelease && cd ..",
    "release:prebuild": "expo prebuild -p android",
    "release:assemble": "cd android && .\\gradlew.bat assembleRelease && cd ..",
    "release:clear-data": "adb shell pm clear com.uwayss.easyweather",
    "release:install": "adb install -f android\\app\\build\\outputs\\apk\\release\\app-release.apk",
    "release:start-app": "adb shell am start -n com.uwayss.easyweather/com.uwayss.easyweather.MainActivity",
    "release": "npm run release:prebuild && npm run release:assemble && npm run release:clear-data && npm run release:install && npm run release:start-app",
    "prebuild": "expo prebuild -p android",
    "deps": "expo install --fix",
    "commit": "npm run checks && ups diff"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^55.0.0",
    "expo-build-properties": "~55.0.16",
    "expo-constants": "~55.0.17",
    "expo-dev-client": "~55.0.37",
    "expo-font": "~55.0.8",
    "expo-image": "~55.0.11",
    "expo-linking": "~55.0.16",
    "expo-location": "~55.1.12",
    "expo-router": "~55.0.17",
    "expo-splash-screen": "~55.0.23",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.20",
    "expo-updates": "~55.0.26",
    "i18next": "^25.2.0",
    "nativewind": "^4.1.23",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^15.5.1",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/react": "~19.2.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~55.0.1",
    "typescript": "~5.9.2"
  },
  "private": true
}
